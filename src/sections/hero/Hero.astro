---
import { Image } from 'astro:assets'
import Me from '../../img/Me-Ny-Edit.jpg'
import Banner from '../../img/banner-blog.jpg'
import HeroInfo from './HeroInfo.astro'
---
<header class="h-1/3 w-full mt-4 mb-8">
    <figure class="flex relative h-72 w-full rounded-t-xl object-fill justify-center overflow-hidden">
        <Image
        src={Banner}
        alt='Profile picture'
        />
    </figure>
    <figure class="absolute mx-16 top-46 w-46 h-46 rounded-full object-bottom ring-4 ring-black/95 overflow-hidden">
        <Image
        class='w-full'
        src={Me}
        alt='Profile picture'
        />
    </figure>
    <HeroInfo />
</header>