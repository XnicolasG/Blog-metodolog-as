---
const navItems = [
    {
        title: "Header",
        Link: "#header",
    },
    {
        title: "Página principal",
        Link: "#home",
    },
    {
        title: "Footer",
        Link: "#footer",
    },
];
---

<nav class="w-full text-xl sticky top-0 border-b border-white/50">
    <ul class="flex gap-x-8 px-8 py-4  backdrop-blur-lg">
        {
            navItems?.map((item) => (
                <a
                    href={item?.Link}
                    class="cursor-pointer text-orange-600 hover:text-white hover:bg-orange-600 rounded-xl px-2 py-1 transition-all duration-150" 
                >
                    {item?.title}
                </a>
            ))
        }
    </ul>
</nav>
